# 로컬 실행에 필요한 환경변수 템플릿. 이 파일은 스크립트가 읽지 않는다.
#
#   cp .env.example .env.local      # local 프로파일용 (git 제외)
#
# 스크립트는 SPRING_PROFILES_ACTIVE(기본 local)에 따라 .env.<profile>을 읽고,
# 공통 값은 .env에서 읽는다. 셸에 이미 export된 값이 파일보다 우선한다.
# secret이 아닌 로컬 기본값은 각 서비스의 application-local.yaml에 있으므로
# 실제로 쓰는 키만 채우면 된다.

# ===== 인프라 (docker compose, 비우면 compose 기본값) =====
MYSQL_PORT=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PORT=
MONGO_PORT=
KAFKA_PORT=
# TEI 이미지 태그. arm64 기본값은 main 스냅샷(cpu-arm64-sha-<commit>), x86은 cpu-1.9.3
TEI_IMAGE_TAG=
TEI_EMBEDDING_PORT=
TEI_RERANKER_PORT=
QDRANT_PORT=
QDRANT_GRPC_PORT=

# ===== 서비스 간 호출 (local 기본값은 localhost 포트) =====
KACHI_USER_SERVICE_BASE_URL=
KACHI_COLLECTOR_SERVICE_BASE_URL=

# ===== user-service =====
KACHI_JWT_SECRET=
KACHI_USER_BINDING_KEY=
KACHI_USER_TELEGRAM_BOT_USERNAME=
KACHI_OAUTH2_SUCCESS_REDIRECT_URI=
# local seed 관리자(admin@kachi.local)의 채널 바인딩 주소. 비우면 자리표시 주소로 심는다.
# 스모크에서 실제 채널로 알림을 받으려면 채운다 (docs/전체-사이클-스모크.md).
KACHI_USER_SEED_ADMIN_SLACK_WEBHOOK_URL=
KACHI_USER_SEED_ADMIN_DISCORD_WEBHOOK_URL=
KACHI_USER_SEED_ADMIN_TELEGRAM_CHAT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Naver는 user-service OAuth2와 collector-service 검색 API가 같은 앱을 쓴다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ===== collector-service =====
FINNHUB_API_KEY=

# ===== ai-service =====
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# ===== notification-worker =====
# 수신 주소는 user-service의 채널 바인딩에서 받으므로 worker에 webhook URL을 두지 않는다.
KACHI_NOTIFICATION_TELEGRAM_BOT_TOKEN=
# notification-worker의 *RealIntegrationTest에서만 사용 (없으면 그 테스트는 건너뛴다)
KACHI_NOTIFICATION_SLACK_WEBHOOK_URL=
KACHI_NOTIFICATION_DISCORD_WEBHOOK_URL=
KACHI_NOTIFICATION_TELEGRAM_CHAT_ID=
